{
  "configs": [
    {
      "description": "Full Integration Test (JSON)"
    }
  ],
  "envs": [
    {
      "key": "APP_NAME",
      "value": "eec-json-service"
    },
    {
      "key": "APP_HOME",
      "value": "C:\\services\\${APP_NAME}"
    },
    {
      "key": "DEPLOY_TAG",
      "value": "v1.0.0-$(hostname)"
    },
    {
      "key": "PATH",
      "value": [
        "${APP_HOME}\\bin",
        "C:\\scripts\\common"
      ]
    }
  ],
  "program": {
    "path": "pwsh",
    "args": ["-Command", "Get-ChildItem Env:APP_*, Env:PATH"]
  }
}
