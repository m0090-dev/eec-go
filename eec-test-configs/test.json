{
  "configs": [
    {
      "description": "Full Integration Test (JSON)"
    }
  ],
  "envs": [
    {
      "APP_NAME": "eec-json-service"
    },
    {
      "APP_HOME": "C:\\services\\${APP_NAME}"
    },
    {
      "DEPLOY_TAG": "v1.0.0-$(hostname)"
    },
    {
      "PATH": [
        "${APP_HOME}\\bin",
        "C:\\scripts\\common"
      ]
    }
  ],
  "program": {
    "path": "pwsh",
    "args": [
      "-Command",
      "Get-ChildItem Env:APP_*, Env:PATH,Env:DEPLOY_TAG"
    ]
  }
}
